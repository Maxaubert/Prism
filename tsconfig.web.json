{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"],
      "prism-term-core/renderer/settings/coreIndex": ["packages/term-core/renderer/settings/coreIndex.ts"],
      "prism-term-core/renderer/settings/sectionIds": ["packages/term-core/renderer/settings/sectionIds.ts"],
      "prism-term-core/renderer/settings/layout/icons": ["packages/term-core/renderer/settings/layout/icons.ts"],
      "prism-term-core/renderer/settings/diagnosticsOptions": ["packages/term-core/renderer/settings/diagnosticsOptions.ts"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/index.d.ts",
    "src/shared/**/*",
    "packages/term-core/renderer/**/*",
    "packages/term-core/shared/**/*",
    "packages/term-core/preload/**/*"
  ]
}
