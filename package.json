{
  "name": "prism",
  "version": "0.127.1",
  "description": "A fast, universal media viewer for Windows.",
  "author": "Max",
  "license": "MIT",
  "main": "./out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pretest": "node tools/check-core-link.mjs",
    "pretypecheck": "node tools/check-core-link.mjs",
    "prebuild": "node tools/check-core-link.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run --passWithNoTests",
    "e2e": "node tools/check-core-link.mjs && npm run fetch:bin && npm run build && node tools/e2e/hidden.mjs tools/e2e/run.mjs",
    "e2e:ui": "node tools/check-core-link.mjs && npm run fetch:bin && npm run build && node tools/e2e/hidden.mjs tools/e2e/run.mjs =settingsLook =diagLog =tabs =sort =pinRecent =updateWindow =updateGuard =updateQuiet",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "package": "node tools/check-core-link.mjs && npm run fetch:bin && npm run build:win-e && npm run build:dwm && npm run build:sweep && electron-vite build && electron-builder --win",
    "build:win-e": "node tools/build-win-e.mjs",
    "build:dwm": "node tools/build-dwm.mjs",
    "build:sweep": "node tools/build-sweep.mjs",
    "test:win-e": "node tools/test-win-e.mjs",
    "fetch:ffmpeg": "node tools/fetch-ffmpeg.mjs",
    "fetch:7zip": "node tools/fetch-7zip.mjs",
    "fetch:bin": "npm run fetch:ffmpeg && npm run fetch:7zip && npm run fetch:fluidsynth && npm run fetch:everything",
    "fetch:everything": "node tools/fetch-everything.mjs",
    "test:everything-bundle": "node tools/test-everything-bundle.mjs",
    "fetch:fluidsynth": "node tools/fetch-fluidsynth.mjs",
    "diag": "node tools/diag.mjs",
    "icons:folders": "node tools/icons/folder-icons.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "adm-zip": "^0.6.0",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "hls.js": "^1.7.2",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "lucide-static": "1.66.0",
    "node-gyp": "^12.4.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.5",
    "prism-term-core": "*",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
