              "call",
              "${CLAUDE_PLUGIN_ROOT}/hook.cmd",
              "working"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
